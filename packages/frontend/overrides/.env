#Variables from this file will be considered only if code ran on the local development from webpack

#Local Development Variable Setup - START

OIDC_PROVIDER=INTERNAL
OIDC_DISABLED=true

# No need to set API_BASEURL for local development ApiClient files has it as per local Setup
API_BASEURL=

#Local Development Variable Setup - END



#DNA Application UI Configurable Values - START

#Points to Wherever the name of the company displayed on app
DNA_COMPANY_NAME=Daimler

#Points to App Name displayed on header
DNA_APPNAME_HEADER=DnA@MBC App

#Points to App Name displayed on home page
DNA_APPNAME_HOME=Data and Analytics @MBC

#Contact Us page static HTML content
DNA_CONTACTUS_HTML=<div><p>There could be many places where you may need our help, and we are happy to support you. <br />Please post your question(s) in our communication channels mentioned below.</p><p>Mattermost:&nbsp;<a href="https://matter.i.daimler.com/daimler-ag/channels/dna-platform" target="_blank" rel="noreferrer">https://matter.i.daimler.com/daimler-ag/channels/dna-platform</a></p><p>Email:&nbsp;<a href="mailto:dna@daimler.com">dna@daimler.com</a></p></div>

#Location of Brand logo URL (Can be local relative url on code base or open internet facing image url) Recommended Size - 266x80 [widthxheght] in pixels 
DNA_BRAND_LOGO_URL=/images/branding/logo-brand.png

#Location of Application logo URL (Can be local relative url on code base or open internet facing image url) Recommended Size - 266x80 [widthxheght] in pixels 
DNA_APP_LOGO_URL=/images/branding/logo-app.png

#DNA Application UI Configurable Values - END



