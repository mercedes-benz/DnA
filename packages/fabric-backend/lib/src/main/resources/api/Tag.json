{
    "library": "spring-boot",
    "dateLibrary": "legacy",
    "interfaceOnly": true,
    "skipDefaultInterface": true,
    "booleanGetterPrefix": "is",
    "enumNameMappings": {
        "PowerBI": "POWERBI",
        "Daimler Buses": "DAIMLERBUSES",
        "Daimler Trucks": "DAIMLERTRUCKS",
        "Mercedes-Benz Cars": "MERCEDES_BENZCARS",
        "Mercedes-Benz Mobility": "MERCEDES_BENZMOBILITY",
        "Mercedes-Benz Vans": "MERCEDES_BENZVANS"
    },
    "useSpringBoot3": true,
    "useJakartaEe": true,
    "openApiNullable": false,
    "hideGenerationTimestamp": true,
    "useTags": true,
    "modelPackage": "com.daimler.data.dto.tag",
    "apiPackage": "com.daimler.data.api.tag",
    "invokerPackage": "com.daimler.data.service.tag",
    "importMappings": {
        "BindingResult":"org.springframework.validation.BindingResult",
        "GenericMessage":"com.daimler.data.controller.exceptions.GenericMessage",
        "MessageDescription":"com.daimler.data.controller.exceptions.MessageDescription"
    }
}